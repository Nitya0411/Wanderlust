<% layout('layouts/boilerplate.ejs') -%>
<% const coords = listing.geometry ? listing.geometry.coordinates : [] %>
<script>
  const maptoken="<%=process.env.MAP_TOKEN%>"
</script>
    <div class="row">
        <div class="col-8 offset-2 mt-3">
            <div class="mb-3">
                 <h1>Edit Listing</h1>
                <form method="POST" action="/listings/<%=listing.id%>?_method=PATCH " enctype="multipart/form-data">
    <label class="form-label"  for="title">Title</label>
                    <input name="listing[title]" value="<%=listing.title%>" class="form-control" required>
                    <div class="invalid-feedback">Title is required</div>
            </div>
            <div class="mb-3">
                 <label class="form-label " for="description">Description</label>
                 <textarea name="listing[description]" class="form-control" required ><%=listing.description%> </textarea>
                 <div class="invalid-feedback">Enter a short description</div>
            </div>

             <div class="mb-3">Preview:
                <img src="<%=originalImage%>" alt="Listing_Image" class="img-fluid" style="max-width:250px; height:auto;">

             </div>
            <div class="mb-3">
                 <label class="form-label " for="image">Upload image</label>
                 <input name="listing[image]"  type="file" class="form-control" >
                 <div class="invalid-feedback">Upload image</div>
            </div>

            <div class="row">
                <div class="mb-3 col-4">
                    <label class="form-label" for="price">Price</label>
                <input name="listing[price]"  type="number" value="<%=listing.price%>" class="form-control" required>
                <div class="invalid-feedback">Price is required</div>
            </div>
             <div class="mb-3 col-8">
                 <label class="form-label" for="country">Country</label>
                <input name="listing[country]" value="<%=listing.country%>" class="form-control" required>
                 <div class="invalid-feedback">Enter valid country</div>
            </div>
            </div>


            <div class="mb-3">
                <label class="form-label mb-3" for="location">Location</label>
                <input name="listing[location]" id="location" value="<%=listing.location%>" class="form-control" required>
                 <div class="invalid-feedback">Enter valid location</div>
            </div>
            <div class="mb-3">
        <label class="form-label" for="category" >Category</label>
        <select name="listing[category]" class="form-control" required>
        <option value="">Select a category</option>
        <option value="trending" <%= listing.category === 'trending' ? 'selected' : '' %>>Trending</option>
        <option value="nature" <%= listing.category === 'nature' ? 'selected' : '' %>>Nature</option>
        <option value="iconic cities" <%= listing.category === 'iconic cities' ? 'selected' : '' %>>Iconic Cities</option>
        <option value="mountains" <%= listing.category === 'mountains' ? 'selected' : '' %>>Mountains</option>
        <option value="camps" <%= listing.category === 'camps' ? 'selected' : '' %>>Camps</option>
        <option value="pools" <%= listing.category === 'pools' ? 'selected' : '' %>>Pools</option>
        <option value="beachfront" <%= listing.category === 'beachfront' ? 'selected' : '' %>>Beachfront</option>
        <option value="arctic" <%= listing.category === 'arctic' ? 'selected' : '' %>>Arctic</option>
        <option value="pet-friendly" <%= listing.category === 'pet-friendly' ? 'selected' : '' %>>Pet-friendly</option>
        <option value="luxury" <%= listing.category === 'luxury' ? 'selected' : '' %>>Luxury</option>
        </select>
    <div class="invalid-feedback">Category is required</div>
</div>
            <div class="mb-3">
                <div id="map" data-coordinates="<%- JSON.stringify(coords) %>"></div>
            </div>
           <button class="btn btn-dark edit-btn mb-3">EDIT</button>
          
    </form>
        </div>

    </div>
    
<script src="/js/map.js"></script>
</body>
</html>

