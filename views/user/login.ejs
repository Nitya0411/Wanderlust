<% layout('layouts/boilerplate.ejs') -%>
<div class="row mt-3">
    <div class="col-6 offset-3">
        <h1 class="col-6 offset-3">Login</h1>
        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div>
                <label class="form-label " for="username">Username</label>
                <input name="username"  id="username" placeholder="Enter a username" type="text" class="form-control mb-3" required>
             </div>

            <div>
                <label class="form-label " for="password">Password</label>
                <input name="password"  id="password" placeholder="Enter a password" class="form-control mb-3" type="password" required>
               
            </div>

            <button class="btn btn-success">Login</button>

        </form>
    </div>
</div>
